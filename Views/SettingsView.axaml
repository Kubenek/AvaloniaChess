<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Chess"
             x:Class="Chess.Views.SettingsView">

    <UserControl.Styles>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#33000000"/>
        </Style>
        <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="#33000000"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#44000000"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="60*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="1" Grid.Column="1" Name="btnBack" Content="← Back" HorizontalAlignment="Left"/>

        <TextBlock Grid.Row="1" Grid.Column="1" Text="Settings" Margin="10" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <ListBox Grid.Row="2" Grid.Column="1" Name="ModeListBox">
            
            
            
        </ListBox>

        <Border Grid.Row="2" Grid.Column="2" BorderThickness="1" BorderBrush="#40FFFFFF" Padding="20" Margin="20,0,0,0">
            
            <StackPanel Name="PreviewPanel">

                <TextBlock Name="PreviewTitle" Text="Setting" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Name="PreviewDescription" Text="This feature isn't implemented yet" TextWrapping="Wrap" Margin="0,0,0,20"/>
                
                <ContentControl Name="PreviewContent"/>

            </StackPanel>
            
        </Border>

    </Grid>

</UserControl>