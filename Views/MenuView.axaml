<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Chess"
             x:Class="Chess.Views.MenuView">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="70*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="1" Text="Avalonia Chess" FontSize="48" HorizontalAlignment="Center"/>

        <Grid Grid.Row="2">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Name="btnStart" Content="Play" FontSize="24" Padding="40,10" HorizontalAlignment="Center" Width="300" HorizontalContentAlignment="Center"/>
            <Button Grid.Row="1" Name="btnSettings" Content="Settings" FontSize="24" Padding="40, 10" HorizontalAlignment="Center" Width="300" HorizontalContentAlignment="Center"/>
            <Button Grid.Row="2" Name="btnQuit" Content="Quit" FontSize="24" Padding="40,10" HorizontalAlignment="Center" Width="300" HorizontalContentAlignment="Center"/>

        </Grid>

    </Grid>


</UserControl>